<!DOCTYPE html>
<html lang="pt-br">

<head>
    <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estoffe - Seu Carrinho</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-gray-50 font-sans min-h-screen flex flex-col pt-24">
    <%- include('_navbar') %>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8">
        <div class="mb-8">
            <span class="text-xs font-bold uppercase tracking-[0.4em] text-green-700 block mb-2">Sacola de
                Compras</span>
            <h1 class="text-3xl md:text-4xl font-light tracking-tight text-gray-900">Seu <span
                    class="font-extrabold">Carrinho</span></h1>
            <div class="w-12 h-[2px] bg-green-700 mt-3"></div>
        </div>

        <nav class="flex gap-6 border-b border-gray-200 mb-8" aria-label="Seções do carrinho">
            <a href="/carrinho?aba=sacola" <%=abaAtiva==='sacola' ? 'aria-current="page"' : '' %>
                class="pb-3 text-sm font-semibold <%= abaAtiva==='sacola' ? 'border-b-2 border-green-900 text-green-950'
                    : 'text-gray-500 hover:text-gray-900' %>">
                    <i class="bi bi-bag mr-1" aria-hidden="true"></i>Sacola
            </a>
            <a href="/carrinho?aba=pagar" <%=abaAtiva==='pagar' ? 'aria-current="page"' : '' %>
                class="pb-3 text-sm font-semibold <%= abaAtiva==='pagar' ? 'border-b-2 border-green-900 text-green-950'
                    : 'text-gray-500 hover:text-gray-900' %>">
                    <i class="bi bi-credit-card mr-1" aria-hidden="true"></i>A pagar
                    <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs">
                        <%= pedidosAPagar.length %>
                    </span>
            </a>
        </nav>

        <% if (abaAtiva==='pagar' ) { %>
            <section aria-labelledby="pedidos-a-pagar-titulo">
                <div class="mb-5">
                    <h2 id="pedidos-a-pagar-titulo" class="text-xl font-bold text-gray-900">Pedidos a pagar</h2>
                    <p class="text-sm text-gray-500 mt-1">Orçamentos avaliados pela equipe e liberados para pagamento.
                    </p>
                </div>
                <% if (pedidosAPagar.length) { %>
                    <div class="divide-y divide-gray-200 border-y border-gray-200">
                        <% pedidosAPagar.forEach((pedido)=> { %>
                            <article class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div>
                                    <h3 class="font-semibold text-gray-900">Pedido #<%= pedido.codPedido %>
                                    </h3>
                                    <p class="text-sm text-gray-600 mt-1">Frete: R$ <%= Number(pedido.valorFrete ||
                                            0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                    </p>
                                    <p class="text-sm font-bold text-gray-900">Total: R$ <%= Number(pedido.valorTotal ||
                                            0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                    </p>
                                </div>
                                <form action="/pedido/<%= pedido.codPedido %>/pagar" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit"
                                        class="inline-flex items-center gap-2 bg-green-950 hover:bg-green-800 text-white font-semibold px-5 py-3 rounded-sm transition-colors text-sm">
                                        <i class="bi bi-credit-card" aria-hidden="true"></i>Pagar
                                    </button>
                                </form>
                                
                            </article>
                           
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="border-y border-gray-200 py-12 text-center">
                            <i class="bi bi-check2-circle text-3xl text-green-800" aria-hidden="true"></i>
                            <p class="mt-3 font-semibold text-gray-800">Não há pedidos aguardando pagamento.</p>
                        </div>
                        <% } %>
            </section>
            <% } else if (produtosNoCarrinho.length===0) { %>
                <div
                    class="bg-white border border-gray-100 rounded-sm p-12 text-center shadow-sm max-w-md mx-auto my-12">
                    <div class="text-gray-300 text-6xl mb-4">
                        <i class="bi bi-cart-x"></i>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 mb-2">Seu carrinho está vazio</h2>
                    <p class="text-gray-500 text-sm mb-6">Que tal navegar pelo catálogo e escolher uma peça exclusiva de
                        alta tapeçaria?</p>
                    <a href="/produtos"
                        class="inline-block bg-green-950 hover:bg-green-800 text-white text-xs font-bold uppercase tracking-wider px-6 py-3 rounded-sm transition duration-300">
                        Ver Produtos
                    </a>
                </div>
                <% } else { %>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

                        <div class="lg:col-span-2 space-y-4">
                            <% produtosNoCarrinho.forEach(item=> { %>
                                <div
                                    class="bg-white border border-gray-100 p-4 rounded-sm shadow-sm flex flex-col sm:flex-row items-center gap-4 transition hover:shadow-md">

                                    <img src="<%= /^(https?:|\/)/i.test(String(item.imagem || '')) ? item.imagem : `/${String(item.imagem || '').replace(/^(\.\.\/|\.\/)+/, '')}` %>" alt="<%= item.nome %>"
                                        class="w-24 h-24 object-cover rounded-sm bg-gray-50">

                                    <div class="flex-grow text-center sm:text-left">
                                        <h3 class="font-bold text-gray-900 text-base">
                                            <%= item.nome %>
                                        </h3>
                                        <p class="text-xs text-gray-400 mt-0.5">Código: #<%= item.codProduto %>
                                        </p>
                                        <p class="text-green-800 font-semibold text-sm mt-2">R$ <%=
                                                item.preco.toLocaleString('pt-BR', { minimumFractionDigits: 2,
                                                maximumFractionDigits: 2 }) %>
                                        </p>
                                        <% if (item.precoOriginal> item.preco) { %>
                                            <p class="text-xs text-gray-400 line-through">Preço original: R$ <%=
                                                    item.precoOriginal.toLocaleString('pt-BR', { minimumFractionDigits:
                                                    2, maximumFractionDigits: 2 }) %>
                                            </p>
                                            <p class="text-xs font-semibold text-red-600"><i class="bi bi-tag-fill"
                                                    aria-hidden="true"></i> Promoção aplicada</p>
                                            <% } %>
                                                <label for="observacao-<%= item.codProduto %>"
                                                    class="block text-left text-xs font-semibold text-gray-500 mt-3 mb-1">
                                                    Observação deste produto
                                                </label>
                                                <textarea id="observacao-<%= item.codProduto %>"
                                                    name="observacoes[<%= item.codProduto %>]"
                                                    form="finalizarPedidoForm" maxlength="255" rows="2"
                                                    placeholder="Ex.: cor, medida ou acabamento"
                                                    class="block w-full max-w-md px-3 py-2 border border-gray-200 rounded-sm text-xs text-gray-700 focus:outline-none focus:ring-2 focus:ring-green-800"></textarea>
                                    </div>

                                    <div
                                        class="flex items-center gap-6 w-full sm:w-auto justify-between sm:justify-end">

                                        <div
                                            class="flex items-center border border-gray-200 bg-gray-50 rounded-sm overflow-hidden">
                                            <form action="/carrinho/atualizar/<%= item.codProduto %>" method="POST"
                                                class="inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="quantidade"
                                                    value="<%= item.quantidade - 1 %>">
                                                <button type="submit" <%=item.quantidade <=1 ? 'disabled' : '' %>
                                                    class="px-2 py-1 text-gray-500 hover:bg-gray-200 hover:text-gray-700
                                                    transition disabled:opacity-30 disabled:hover:bg-transparent
                                                    cursor-pointer">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                            </form>

                                            <span
                                                class="px-3 py-1 text-sm font-bold text-gray-800 bg-white min-w-[32px] text-center select-none">
                                                <%= item.quantidade %>
                                            </span>

                                            <form action="/carrinho/atualizar/<%= item.codProduto %>" method="POST"
                                                class="inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="quantidade"
                                                    value="<%= item.quantidade + 1 %>">
                                                <button type="submit"
                                                    class="px-2 py-1 text-gray-500 hover:bg-gray-200 hover:text-gray-700 transition cursor-pointer">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <div class="text-right min-w-[90px]">
                                            <span class="block text-xs text-gray-400">Subtotal</span>
                                            <span class="font-extrabold text-gray-900 text-sm">R$ <%=
                                                    item.subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2 }) %></span>
                                        </div>

                                        <form action="/carrinho/remover/<%= item.codProduto %>" method="POST"
                                            class="inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit"
                                                class="text-gray-400 hover:text-red-600 p-2 transition"
                                                title="Remover item">
                                                <i class="bi bi-trash3 text-lg"></i>
                                            </button>
                                        </form>
                                    </div>

                                </div>
                                <% }) %>

                                    <div class="pt-2">
                                        <a href="/produtos"
                                            class="text-sm text-green-800 hover:text-green-950 font-medium inline-flex items-center gap-2 transition">
                                            <i class="bi bi-arrow-left"></i> Continuar comprando
                                        </a>
                                    </div>
                        </div>
                        <div class="pt-2">
                            <!-- Campo de Metragem -->
                            <div class="mb-6 bg-green-50/60 p-4 rounded-lg border border-green-100">
                                <label for="metragem" class="block text-sm font-semibold text-green-900 mb-1">
                                    Metragem (m²)
                                </label>
                                <input type="number" step="0.01" min="0.1" id="metragem" name="metragem" form="finalizarPedidoForm"
                                    placeholder="Opcional: ex. 2,50"
                                    class="block w-full px-3.5 py-2 bg-white border border-green-300 rounded-md text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-800 focus:border-transparent transition shadow-sm">
                            </div>

                            <div class="mb-6 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                                <h2 class="text-sm font-bold text-gray-900">Código promocional</h2>
                                <% if (codigoStatus==='invalido' ) { %>
                                    <p class="mt-2 text-xs font-semibold text-red-600">Código inválido, expirado ou
                                        inativo.
                                    </p>
                                    <% } else if (codigoStatus==='aplicado' ) { %>
                                        <p class="mt-2 text-xs font-semibold text-green-700">Código aplicado com
                                            sucesso.
                                        </p>
                                        <% } else if (codigoStatus==='removido' ) { %>
                                            <p class="mt-2 text-xs text-gray-600">Código promocional removido.</p>
                                            <% } %>
                                                <% if (codigoPromocional) { %>
                                                    <div
                                                        class="mt-3 flex items-center justify-between gap-3 rounded bg-green-50 p-2 text-xs">
                                                        <span><strong>
                                                                <%= codigoPromocional.codigo %>
                                                            </strong> - <%=
                                                                Number(codigoPromocional.percentual).toLocaleString('pt-BR')
                                                                %>% de desconto</span>
                                                        <button type="submit" form="removerCodigoForm"
                                                            class="font-semibold text-red-700 hover:text-red-900">Remover</button>
                                                    </div>
                                                    <% } else { %>
                                                        <form action="/carrinho/codigo-promocional" method="POST"
                                                            class="mt-3 flex gap-2">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <label for="codigo-promocional" class="sr-only">Código
                                                                promocional</label>
                                                            <input id="codigo-promocional" name="codigo" required
                                                                maxlength="40" placeholder="Ex.: ESTOFFE10"
                                                                class="min-w-0 flex-1 rounded border border-gray-300 px-3 py-2 text-xs uppercase focus:border-green-800 focus:outline-none">
                                                            <button type="submit"
                                                                class="rounded bg-green-900 px-3 py-2 text-xs font-semibold text-white hover:bg-green-800">Aplicar</button>
                                                        </form>
                                                        <% } %>
                            </div>

                            <form id="removerCodigoForm" action="/carrinho/codigo-promocional" method="POST"
                                class="hidden">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="acao" value="remover">
                            </form>

                            <!-- Resumo do Pedido -->
                            <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Resumo do
                                Pedido</h2>

                            <div class="space-y-3 text-sm mt-4">
                                <div class="flex justify-between text-gray-600">
                                    <span>Subtotal dos itens</span>
                                    <span>R$ <%= subtotalProdutos.toLocaleString('pt-BR', { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %></span>
                                </div>

                                <% if (descontoCodigo> 0) { %>
                                    <div class="flex justify-between font-semibold text-green-700">
                                        <span>Desconto (<%= codigoPromocional.codigo %>)</span>
                                        <span>- R$ <%= descontoCodigo.toLocaleString('pt-BR', { minimumFractionDigits:
                                                2, maximumFractionDigits: 2 }) %></span>
                                    </div>
                                    <% } %>

                                        <div class="flex justify-between text-gray-600">
                                            <span>Entrega / Frete</span>
                                            <% if (freteGratis) { %>
                                                <span class="font-semibold text-green-700">Grátis</span>
                                                <% } else if (frete) { %>
                                                    <span class="font-medium text-gray-900">R$ <%=
                                                            valorFrete.toLocaleString('pt-BR', { minimumFractionDigits:
                                                            2, maximumFractionDigits: 2 }) %></span>
                                                    <% } else { %>
                                                        <span class="font-medium text-orange-700">Informe um CEP
                                                            válido</span>
                                                        <% } %>
                                        </div>
                                        <% if (freteGratis) { %>
                                            <p class="text-right text-xs font-semibold text-green-700">Frete grátis
                                                aplicado
                                            </p>
                                            <% } else if (frete) { %>
                                                <p class="text-right text-xs text-gray-500">CEP <%= cepEntrega %> -
                                                        prazo
                                                        estimado: <%= frete.prazo_dias %> dias úteis</p>
                                                <% } else { %>
                                                    <p class="text-xs text-orange-700">Cadastre o CEP no seu perfil para
                                                        calcular a entrega.</p>
                                                    <% } %>

                                                        <hr class="border-gray-100 my-2">

                                                        <div
                                                            class="flex justify-between text-base font-bold text-gray-900 pt-2">
                                                            <span>Total Estimado</span>
                                                            <span id="totalEstimado" data-subtotal="<%= subtotalProdutos %>" data-desconto="<%= descontoCodigo %>" data-frete="<%= valorFrete %>" class="text-xl text-green-950">
                                                                R$ <%= total.toLocaleString('pt-BR', {
                                                                    minimumFractionDigits: 2, maximumFractionDigits: 2
                                                                    }) %>
                                                            </span>
                                                        </div>
                            </div>



                            <form action="/finalizar-compra" method="POST" id="finalizarPedidoForm">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit"
                                    class="w-full bg-green-950 hover:bg-green-800 text-white font-semibold py-3 px-4 rounded-sm transition duration-300 uppercase tracking-wider text-xs flex items-center justify-center gap-2 cursor-pointer shadow-sm text-center">Finalizar
                                    Compra</button>
                            </form>
                            <p class="text-[11px] text-gray-400 text-center leading-relaxed">
                                Ao finalizar, nossa equipe avaliará o pedido e informará o frete antes de liberar o
                                pagamento.
                            </p>
                        </div>

                    </div>
                    <% } %>
    </main>

    <script src="/pages/js/carrinho-offline.js" defer></script>
    <script>
        const finalizarPedidoForm = document.getElementById("finalizarPedidoForm");
        const metragem = document.getElementById("metragem");
        const totalEstimado = document.getElementById("totalEstimado");
        const atualizarTotalEstimado = () => {
            if (!metragem || !totalEstimado) return;
            const metragemInformada = metragem.value.trim() ? Number(metragem.value) : 1;
            if (!Number.isFinite(metragemInformada) || metragemInformada <= 0) return;
            const subtotal = Number(totalEstimado.dataset.subtotal) * metragemInformada;
            const desconto = Number(totalEstimado.dataset.desconto) * metragemInformada;
            const frete = Number(totalEstimado.dataset.frete);
            totalEstimado.textContent = `R$ ${Math.max(0, subtotal - desconto + frete).toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        };
        metragem?.addEventListener("input", atualizarTotalEstimado);
        atualizarTotalEstimado();
        finalizarPedidoForm?.addEventListener("submit", (event) => {
            if (finalizarPedidoForm.dataset.enviando === "true") {
                event.preventDefault();
                return;
            }

            finalizarPedidoForm.dataset.enviando = "true";
            const botao = finalizarPedidoForm.querySelector('button[type="submit"]');
            if (botao) {
                botao.disabled = true;
                botao.setAttribute("aria-busy", "true");
                botao.textContent = "Processando...";
                botao.classList.add("cursor-wait", "opacity-90");
            }
        });
    </script>
</body>

</html>