<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meu Perfil - Estoffe</title>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="bg-gray-100 pt-24">
  <%- include('../_navbar') %>

  <main class="max-w-4xl mx-auto px-4 py-8 space-y-8">
    <% if (error==='cpf_obrigatorio' ) { %>
      <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 rounded-lg p-4">
        Informe um CPF ou CNPJ válido no seu perfil para continuar o pagamento.
      </div>
      <% } else if (error==='cpf_invalido' ) { %>
        <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
          O CPF ou CNPJ informado é inválido.
        </div>
        <% } %>

          <div class="bg-white rounded-lg shadow-xl overflow-hidden">
            <div class="bg-green-900 p-6 text-white flex items-center space-x-4">
              <div class="flex items-center space-x-4 text-left">
                <div class="bg-green-800 p-4 rounded-full border-2 border-white text-3xl">
                  <i class="bi bi-person"></i>
                </div>
                <div>
                  <h2 class="text-2xl font-bold uppercase tracking-wide">
                    Minha Conta
                  </h2>
                  <p class="text-green-200 text-sm">
                    Gerencie suas informações pessoais e de entrega
                  </p>
                </div>
              </div>
            </div>

            <form action="/client/atualizar-perfil" method="POST" class="p-6 space-y-6">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Nome Completo</label>
                    <input type="text" name="nome"
                      value="<%= typeof usuario !== 'undefined' ? usuario.nome : 'Nome do Cliente' %>" required
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-900 focus:outline-none transition-all" />
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">E-mail</label>
                    <input type="email" name="email"
                      value="<%= typeof usuario !== 'undefined' ? usuario.email : 'cliente@email.com' %>" disabled
                      class="w-full px-4 py-2 border border-gray-200 bg-gray-100 text-gray-500 rounded-lg cursor-not-allowed" />
                    <p class="text-xs text-gray-400 mt-1">
                      O e-mail não pode ser alterado por motivos de segurança.
                    </p>
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Telefone / WhatsApp</label>
                    <input type="text" id="telefone" name="telefone" maxlength="15"
                      value="<%= typeof telefone !== 'undefined' && telefone ? telefone : '' %>"
                      placeholder="(11) 99999-9999"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-900 focus:outline-none transition-all" />
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">CPF / CNPJ</label>
                    <input type="text" id="cpf" name="cpf" maxlength="18"
                      value="<%= typeof cpf !== 'undefined' && cpf ? cpf : '' %>"
                      placeholder="CPF ou CNPJ válido"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-900 focus:outline-none transition-all" />
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Endereço Completo de Entrega</label>
                    <input type="text" name="endereco"
                      value="<%= typeof endereco !== 'undefined' && endereco ? endereco : '' %>"
                      placeholder="Rua, Número, Bairro, Cidade - Estado"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-900 focus:outline-none transition-all" />
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2" for="cep">CEP de entrega</label>
                    <input type="text" id="cep" name="cep" inputmode="numeric" maxlength="9"
                      value="<%= typeof cep !== 'undefined' && cep ? cep : '' %>" placeholder="00000-000"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-900 focus:outline-none transition-all" />
                  </div>
                </div>

                <hr class="border-gray-200 my-6" />

                <div>
                  <h3 class="text-lg font-bold text-gray-800 mb-2">
                    <i class="bi bi-lock mr-2"></i>Alterar Senha
                  </h3>
                  <p class="text-xs text-gray-500 mb-4">
                    A senha deve conter no mínimo 8 caracteres para garantir a
                    segurança da criptografia.
                  </p>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                      <label for="novaSenha" class="block text-sm font-medium text-gray-700">Sua Senha</label>
                      <div class="relative mt-1">
                        <input type="password" id="novaSenha" name="novaSenha" placeholder="No mínimo 8 caracteres"
                          minlength="8"
                          class="block w-full px-4 py-2 bg-white border border-gray-300 rounded-md text-gray-900 focus:ring-green-500 focus:border-green-500 form-control">

                        <button type="button"
                          class="toggle-senha absolute right-3 top-1/2 -translate-y-1/2 btn btn-link p-0 text-muted"
                          data-target="novaSenha" aria-label="Mostrar senha">
                          <i class="bi bi-eye"></i>
                        </button>
                      </div>
                    </div>

                    <div>
                      <label for="confirmarSenha" class="block text-sm font-medium text-gray-700">Confirme sua
                        Senha</label>
                      <div class="relative mt-1">
                        <input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Repita a senha"
                          minlength="8"
                          class="block w-full px-4 py-2 bg-white border border-gray-300 rounded-md text-gray-900 focus:ring-green-500 focus:border-green-500">

                        <button type="button"
                          class="toggle-senha absolute right-3 top-1/2 -translate-y-1/2 btn btn-link p-0 text-muted"
                          data-target="confirmarSenha" aria-label="Mostrar senha">
                          <i class="bi bi-eye"></i>
                        </button>
                      </div>
                      <p id="mensagemErro" class="text-sm text-red-600 mt-1 hidden">As senhas não coincidem.</p>
                    </div>
                  </div>
                </div>

                <div class="flex justify-end pt-4">
                  <button type="submit"
                    class="bg-green-900 hover:bg-green-950 text-white font-bold px-6 py-2.5 rounded-lg shadow-md transition-colors duration-300 flex items-center">
                    <i class="bi bi-check-circle mr-2"></i>Salvar Alterações
                  </button>
                </div>
            </form>
          </div>
  </main>

  <script>
    function aplicarMascara(input, formatar) {
      if (!input) return;
      input.addEventListener("input", () => {
        input.value = formatar(input.value);
      });
    }

    function formatarTelefone(valor) {
      const digitos = valor.replace(/\D/g, "").slice(0, 11);
      if (digitos.length <= 2) return digitos;
      const ddd = `(${digitos.slice(0, 2)}) `;
      const numero = digitos.slice(2);
      if (digitos.length > 10) {
        return `${ddd}${numero.slice(0, 5)}${numero.length > 5 ? `-${numero.slice(5)}` : ""}`;
      }
      return `${ddd}${numero.slice(0, 4)}${numero.length > 4 ? `-${numero.slice(4)}` : ""}`;
    }

    function formatarCpfCnpj(valor) {
      const digitos = valor.replace(/\D/g, "").slice(0, 14);
      if (digitos.length > 11) {
        return digitos
          .replace(/^(\d{2})(\d)/, "$1.$2")
          .replace(/^(\d{2})\.(\d{3})(\d)/, "$1.$2.$3")
          .replace(/\.(\d{3})(\d)/, ".$1/$2")
          .replace(/(\d{4})(\d)/, "$1-$2");
      }
      return digitos
        .replace(/^(\d{3})(\d)/, "$1.$2")
        .replace(/^(\d{3})\.(\d{3})(\d)/, "$1.$2.$3")
        .replace(/\.(\d{3})(\d)/, ".$1-$2");
    }

    function formatarCep(valor) {
      return valor
        .replace(/\D/g, "")
        .slice(0, 8)
        .replace(/^(\d{5})(\d)/, "$1-$2");
    }

    aplicarMascara(document.getElementById("telefone"), formatarTelefone);
    aplicarMascara(document.getElementById("cpf"), formatarCpfCnpj);
    aplicarMascara(document.getElementById("cep"), formatarCep);

  </script>
  <script src="/pages/animacoes/anima_gerais.js"></script>
  <script src="../../pages/js/toggleSenha.js"></script>
</body>

</html>