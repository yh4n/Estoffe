<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meus pedidos - Estoffe</title>
    <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-stone-50 font-sans text-gray-800">
    <%- include('../_navbar') %>

    <main class="mx-auto max-w-7xl px-4 pb-8 pt-24 sm:px-6 lg:px-8 lg:pb-10">
        <% if (pedidoSucesso === 'orcamento') { %>
            <% if (notificacaoFrete === 'erro') { %>
                <div role="alert" class="mb-6 flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                    <i class="bi bi-exclamation-circle mt-0.5 text-lg" aria-hidden="true"></i>
                    <p>Solicitação recebida. Não foi possível enviar o e-mail, mas a prévia do frete e o andamento estão disponíveis neste painel.</p>
                </div>
            <% } else { %>
                <div role="status" class="mb-6 flex gap-3 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-900">
                    <i class="bi bi-check-circle mt-0.5 text-lg" aria-hidden="true"></i>
                    <p>Solicitação recebida. Enviamos uma prévia do frete por e-mail; o valor final será confirmado pela equipe.</p>
                </div>
            <% } %>
        <% } %>
        <% if (decisaoOrcamento) { %>
            <div role="status" class="mb-6 flex gap-3 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
                <i class="bi bi-check-circle mt-0.5 text-lg" aria-hidden="true"></i>
                <p>Sua decisão de <%= decisaoOrcamento.toLowerCase() %> o orçamento foi registrada.</p>
            </div>
        <% } %>
        <% if (notificacaoOrcamento === 'erro') { %>
            <div role="alert" class="mb-6 flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                <i class="bi bi-exclamation-circle mt-0.5 text-lg" aria-hidden="true"></i>
                <p>A decisão foi registrada, mas não foi possível enviar o e-mail de confirmação.</p>
            </div>
        <% } %>

        <section class="relative mb-8 overflow-hidden rounded-2xl bg-green-950 px-6 py-7 text-white shadow-lg shadow-green-950/10 sm:px-9 sm:py-9">
            <div class="absolute -right-10 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
            <div class="absolute -right-2 -top-12 h-48 w-48 rounded-full border border-white/10"></div>
            <div class="relative flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-300">Sua conta Estoffe</p>
                    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Olá, <%= usuario.nome %></h1>
                    <p class="mt-2 max-w-xl text-sm leading-relaxed text-green-100 sm:text-base">Acompanhe seus pedidos, aprove orçamentos e veja as novidades da produção em um só lugar.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="#pedidos" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-green-950 transition hover:bg-green-50">
                        <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>Ver meus pedidos
                    </a>
                    <a href="/produtos" class="inline-flex items-center gap-2 rounded-lg border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">
                        <i class="bi bi-shop" aria-hidden="true"></i>Explorar produtos
                    </a>
                </div>
            </div>
        </section>

        <% const totalPedidos = pedidos ? pedidos.length : 0; %>
        <% const pedidosEmAndamento = pedidos ? pedidos.filter((pedido) => !['Entregue', 'Cancelado'].includes(pedido.status)).length : 0; %>
        <section class="mb-10 grid gap-4 sm:grid-cols-2" aria-label="Resumo da conta">
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-50 text-xl text-green-900"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Pedidos registrados</p>
                    <p class="mt-0.5 text-2xl font-bold text-gray-900"><%= totalPedidos %></p>
                </div>
            </article>
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-700"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Em acompanhamento</p>
                    <p class="mt-0.5 text-2xl font-bold text-gray-900"><%= pedidosEmAndamento %></p>
                </div>
            </article>
        </section>

        <% if (pagamento) { %>
            <section class="mb-8 rounded-2xl border border-green-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="pagamento-titulo">
                <div class="mb-5 flex items-start gap-3">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-green-50 text-xl text-green-900"><i class="bi bi-qr-code" aria-hidden="true"></i></span>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-green-800">Pedido recebido</p>
                        <h2 id="pagamento-titulo" class="mt-1 text-xl font-bold text-gray-900">Pague com PIX para iniciar a produção</h2>
                    </div>
                </div>
                <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-center">
                    <img src="data:image/png;base64,<%= pagamento.qrCode %>" alt="QR Code Pix para pagamento" class="h-44 w-44 rounded-lg border border-gray-200 bg-white p-2">
                    <div class="w-full flex-1">
                        <p class="mb-3 text-sm text-gray-600">Total a pagar: <strong class="text-lg text-green-950">R$ <%= pagamento.total.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong></p>
                        <label for="pixCode" class="mb-1 block text-xs font-semibold text-gray-500">Código Pix copia e cola</label>
                        <div class="flex gap-2">
                            <input type="text" id="pixCode" readonly value="<%= pagamento.copiaECola %>" class="min-w-0 flex-1 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-700">
                            <button type="button" id="copiarPixButton" class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-green-950 px-4 py-2 text-sm font-semibold text-white hover:bg-green-800">
                                <i class="bi bi-copy" aria-hidden="true"></i>Copiar
                            </button>
                        </div>
                        <p class="mt-3 text-xs text-gray-500">Após a confirmação do pagamento, o status será atualizado automaticamente.</p>
                        <p id="pixFeedback" class="mt-2 text-xs text-green-800" role="status" aria-live="polite"></p>
                    </div>
                </div>
            </section>
            <script>
                document.getElementById("copiarPixButton").addEventListener("click", async () => {
                    const input = document.getElementById("pixCode");
                    try {
                        await navigator.clipboard.writeText(input.value);
                        document.getElementById("pixFeedback").textContent = "Código Pix copiado.";
                    } catch (error) {
                        input.select();
                        document.getElementById("pixFeedback").textContent = "Selecione e copie o código manualmente.";
                    }
                });
            </script>
        <% } %>

        <% if (continuarPagamento) { %>
            <form id="retomarPagamentoForm" action="/pedido/<%= continuarPagamento %>/pagar" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="mb-8 inline-flex items-center gap-2 rounded-lg bg-green-950 px-5 py-3 text-sm font-semibold text-white hover:bg-green-800">
                    <i class="bi bi-credit-card" aria-hidden="true"></i>Continuar pagamento
                </button>
            </form>
        <% } %>

        <section id="pedidos" class="scroll-mt-24">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-green-800">Acompanhamento</p>
                    <h2 class="mt-1 text-2xl font-bold text-gray-900">Meus pedidos</h2>
                </div>
                <a href="/notificacoes" class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-green-800 hover:text-green-900">
                    <i class="bi bi-bell" aria-hidden="true"></i>Ver notificações
                </a>
            </div>

            <% if (pedidos && pedidos.length) { %>
                <div class="space-y-4">
                    <% pedidos.forEach((pedido) => { %>
                        <% const statusEstilo = pedido.status === 'Entregue' ? 'bg-green-100 text-green-800' : pedido.status === 'Cancelado' ? 'bg-red-100 text-red-800' : pedido.status === 'Em Produção' ? 'bg-amber-100 text-amber-900' : 'bg-blue-50 text-blue-800'; %>
                        <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
                            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4 sm:px-6">
                                <div>
                                    <h3 class="font-bold text-gray-900">Pedido #<%= pedido.codPedido %></h3>
                                    <p class="mt-0.5 text-xs text-gray-500">Realizado em <%= pedido.dataPedido ? new Date(pedido.dataPedido).toLocaleDateString('pt-BR') : 'data não informada' %></p>
                                </div>
                                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= statusEstilo %>"><%= pedido.status %></span>
                            </div>

                            <div class="grid gap-5 p-5 sm:p-6 lg:grid-cols-[minmax(0,1fr)_auto]">
                                <div class="min-w-0 space-y-3">
                                    <% if (pedido.fotosAcompanhamento && pedido.fotosAcompanhamento.length) { %>
                                        <div>
                                            <p class="mb-2 text-xs font-bold uppercase tracking-wide text-gray-500"><i class="bi bi-camera mr-1"></i>Fotos do andamento</p>
                                            <div class="flex flex-wrap gap-2">
                                                <% pedido.fotosAcompanhamento.forEach((foto) => { %>
                                                    <a href="/pedido/<%= pedido.codPedido %>/fotos/<%= foto.codFoto %>" target="_blank" rel="noopener noreferrer"
                                                        class="group w-24 overflow-hidden rounded-lg border border-gray-200 bg-white">
                                                        <img src="/pedido/<%= pedido.codPedido %>/fotos/<%= foto.codFoto %>" alt="<%= foto.legenda || `Andamento do pedido ${pedido.codPedido}` %>" class="h-20 w-24 object-cover transition group-hover:scale-105">
                                                        <span class="block truncate px-2 py-1.5 text-[10px] text-gray-600"><%= foto.legenda || 'Ver foto' %></span>
                                                    </a>
                                                <% }); %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (!pedido.statusOrcamento && pedido.status === 'Aguardando Avaliação') { %>
                                        <div class="rounded-lg bg-blue-50 p-3 text-sm text-blue-900">
                                            <p class="font-semibold"><i class="bi bi-truck mr-1"></i>Frete pré-estimado</p>
                                            <p class="mt-1">
                                                <% if (pedido.freteGratisEstimado) { %>
                                                    Grátis conforme cupom
                                                <% } else if (pedido.valorFreteEstimado !== null && pedido.valorFreteEstimado !== undefined) { %>
                                                    R$ <%= Number(pedido.valorFreteEstimado).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                                <% } else { %>
                                                    A confirmar pela equipe
                                                <% } %>
                                                <% if (pedido.prazoFreteEstimado) { %> · estimativa de <%= pedido.prazoFreteEstimado %> dias úteis<% } %>
                                            </p>
                                            <p class="mt-1 text-xs text-blue-700">O valor final será confirmado no orçamento.</p>
                                        </div>
                                    <% } %>

                                    <% if (pedido.statusOrcamento) { %>
                                        <% const statusOrcamentoEstilo = pedido.statusOrcamento === 'Aprovado' ? 'text-green-800' : pedido.statusOrcamento === 'Recusado' ? 'text-red-700' : 'text-amber-800'; %>
                                        <div class="rounded-lg border border-gray-100 bg-stone-50 p-4">
                                            <p class="text-sm font-bold <%= statusOrcamentoEstilo %>">Orçamento <%= pedido.statusOrcamento %></p>
                                            <% if (pedido.mensagemOrcamento) { %>
                                                <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-gray-700"><%= pedido.mensagemOrcamento %></p>
                                            <% } %>
                                            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600">
                                                <span>Itens: R$ <%= Number(pedido.valorTotal - pedido.valorMaoDeObra - pedido.valorFrete).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                                <span>Mão de obra: R$ <%= Number(pedido.valorMaoDeObra || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                                <span>Frete: R$ <%= Number(pedido.valorFrete || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                            </div>
                                            <p class="mt-2 text-sm font-bold text-gray-900">Total da proposta: R$ <%= Number(pedido.valorTotal).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                                            <% if (pedido.statusOrcamento === 'Pendente') { %>
                                                <div class="mt-4 flex flex-wrap gap-2">
                                                    <form action="/pedido/<%= pedido.codPedido %>/orcamento/resposta" method="POST">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="hidden" name="decisao" value="Aprovado">
                                                        <button type="submit" class="rounded-lg bg-green-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-800">Aprovar orçamento</button>
                                                    </form>
                                                    <form action="/pedido/<%= pedido.codPedido %>/orcamento/resposta" method="POST" onsubmit="return confirm('Deseja recusar este orçamento?')">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="hidden" name="decisao" value="Recusado">
                                                        <button type="submit" class="rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50">Recusar</button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>

                                    <% if (pedido.dataColeta || pedido.dataEntrega) { %>
                                        <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-600">
                                            <span><i class="bi bi-box-arrow-in-down mr-1 text-green-800"></i>Coleta: <%= pedido.dataColetaFormatada ? pedido.dataColetaFormatada.split('-').reverse().join('/') : 'não agendada' %></span>
                                            <span><i class="bi bi-house-check mr-1 text-green-800"></i>Entrega: <%= pedido.dataEntregaFormatada ? pedido.dataEntregaFormatada.split('-').reverse().join('/') : 'não agendada' %></span>
                                        </div>
                                    <% } %>

                                    <% if (pedido.status === 'Aguardando Pagamento' && !pedido.statusOrcamento) { %>
                                        <p class="text-sm text-gray-600">Frete: R$ <%= Number(pedido.valorFrete || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                                        <p class="text-sm font-bold text-gray-900">Total: R$ <%= Number(pedido.valorTotal).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                                    <% } %>
                                </div>

                                <% if (pedido.status === 'Aguardando Pagamento' && pedido.statusOrcamento !== 'Pendente' && pedido.statusOrcamento !== 'Recusado' && pedido.statusPagamento !== 'Aprovado') { %>
                                    <div class="lg:self-start">
                                        <form action="/pedido/<%= pedido.codPedido %>/pagar" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-green-950 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-green-800 sm:w-auto">
                                                <i class="bi bi-credit-card" aria-hidden="true"></i>Pagar pedido
                                            </button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
                    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-green-50 text-2xl text-green-900"><i class="bi bi-bag" aria-hidden="true"></i></span>
                    <h3 class="mt-4 text-lg font-bold text-gray-900">Você ainda não tem pedidos</h3>
                    <p class="mx-auto mt-1 max-w-md text-sm text-gray-500">Quando você fizer um pedido ou solicitar um orçamento, o acompanhamento vai aparecer aqui.</p>
                    <a href="/produtos" class="mt-5 inline-flex items-center gap-2 rounded-lg bg-green-950 px-5 py-3 text-sm font-semibold text-white hover:bg-green-800">
                        <i class="bi bi-shop" aria-hidden="true"></i>Conhecer produtos
                    </a>
                </div>
            <% } %>
        </section>
    </main>

    <footer class="mt-12 border-t border-gray-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
            <span>Estoffe · Área do cliente</span>
            <a href="/contato" class="font-medium text-green-900 hover:text-green-700">Precisa de ajuda? Fale com a gente</a>
        </div>
    </footer>

    <script src="/pages/animacoes/anima_gerais.js"></script>
</body>

</html>
