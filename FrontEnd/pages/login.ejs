<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96">

  <title>Login - Estoffe</title>

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Tailwind -->
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>

  <!-- Seu CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">

</head>

<body>

  <main class="login-page">
    <a class="home-link" href="/" aria-label="Voltar à página inicial">
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <span>Voltar à página inicial</span>
    </a>

    <!-- ÁREA ESQUERDA -->
    <section class="login-brand">

      <div class="brand-content">

        <div class="sofa-area">

          <!-- URSO -->
          <img src="/image/Novo_grupo/estoffinho.png" class="bear-image" alt="Estoffinho">

        </div>

        <div class="brand-text">
          <h1>Estoffe</h1>

          <p>
            Conforto, elegância e estilo
            para transformar seus ambientes.
          </p>
        </div>

      </div>

    </section>


    <!-- ÁREA DIREITA -->
    <section class="login-section">

      <div class="login-card">

        <div class="login-header">
          <span class="login-icon">
            <i class="bi bi-person"></i>
          </span>

          <h2>Faça Login</h2>

          <p>
            Entre na sua conta para continuar
          </p>
        </div>


        <!-- MENSAGEM DE ERRO -->
        <% if (typeof error !=='undefined' && error) { %>

          <div class="error-message" role="alert" aria-live="assertive">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <%= error %>
          </div>

          <% } %>


            <!-- FORMULÁRIO -->
            <form action="/login" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="cartOffline" id="cartOffline" value="[]">
              <!-- EMAIL -->
              <div class="input-group">

                <label for="email">
                  Email
                </label>

                <div class="input-wrapper">

                  <i class="bi bi-envelope"></i>

                  <input type="email" id="email" name="email" placeholder="Digite seu email" autocomplete="email"
                    value="<%= typeof email === 'string' ? email : '' %>" required>

                </div>

              </div>


              <!-- SENHA -->
              <div class="input-group">

                <label for="password">
                  Senha
                </label>

                <div class="input-wrapper relative mt-1">

                  <i class="bi bi-lock"></i>

                  <input type="password" id="password" name="password" placeholder="Digite sua senha"
                    autocomplete="current-password" required>

                  <button type="button" class="toggle-senha" data-target="password" aria-label="Mostrar senha">

                    <i class="bi bi-eye"></i>

                  </button>

                </div>

              </div>


              <!-- ESQUECEU A SENHA -->
              <div class="forgot-password">

                <a href="/forgot-password">
                  Esqueceu a senha?
                </a>

              </div>

              <!-- Google Sign-In -->
              <div class="space-y-3 mb-6">
                <a href="/auth/google"
                  class="w-full flex items-center justify-center gap-3 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-medium text-sm px-4 py-3 rounded-md transition-colors duration-300">
                  <svg class="w-5 h-5" viewBox="0 0 48 48">
                    <path fill="#FFC107"
                      d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z" />
                    <path fill="#FF3D00"
                      d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z" />
                    <path fill="#4CAF50"
                      d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z" />
                    <path fill="#1976D2"
                      d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z" />
                  </svg>
                  Continuar com Google
                </a>

                <button type="submit" class="login-button">
                  <span>Entrar</span>
                  <i class="bi bi-arrow-right"></i>
                </button>

                <div class="register">
                  <span>Não tem uma conta?</span>
                  <a href="/register">Registrar-se</a>
                </div>
              </div>
            </form>

      </div>

    </section>

  </main>

  <footer>

    <div class="footer-content">

      <div>

        <p class="footer-brand">
          Estoffe
        </p>

        <p class="footer-copy">
          © 2026 Estoffe Estofaria Premium.
          Todos os direitos reservados.
        </p>

      </div>


      <div class="social-icons">

        <a href="/">
          <i class="bi bi-house"></i>
        </a>
        <a href="#">
          <i class="bi bi-instagram"></i>
        </a>

        <a href="#">
          <i class="bi bi-facebook"></i>
        </a>

        <a href="#">
          <i class="bi bi-whatsapp"></i>
        </a>

      </div>

    </div>

  </footer>

  <!-- JS -->
  <script src="/pages/js/toggleSenha.js"></script>
  <script src="/pages/js/carrinho-offline.js" defer></script>

  <script src="/pages/animacoes/anima_gerais.js"></script>

</body>

</html>