<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novos Orçamentos - Estoffe Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="min-h-screen bg-stone-50 text-gray-800 antialiased">
  <%- include('_admin-nav') %>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="mb-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-green-800">Comercial</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Orçamentos</h1>
      <p class="mt-2 text-gray-600">Prepare propostas e acompanhe as respostas dos clientes.</p>
    </div>
    <% if (notificacao === 'enviada') { %>
      <div role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
        Orçamento enviado. O cliente recebeu um aviso por e-mail ou pela central de notificações do app.
      </div>
    <% } else if (notificacao === 'erro') { %>
      <div role="alert" class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        O orçamento foi salvo, mas os avisos ao cliente não foram concluídos. Confira o cadastro e a configuração de e-mail.
      </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="p-6 overflow-x-auto">
        <% if (orcamentos && orcamentos.length > 0) { %>
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <label class="inline-flex items-center gap-2 text-sm font-medium text-gray-700">
              <input type="checkbox" id="selecionarTodosOrcamentos" class="h-4 w-4 accent-green-800">
              Selecionar todos
            </label>
            <button type="button" id="analisarSelecionados" disabled
              class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50">
              Abrir análises selecionadas
            </button>
          </div>
          <p id="resumoSelecaoOrcamentos" class="mb-3 text-xs text-gray-500" aria-live="polite"></p>
        <% } %>
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-200">
              <th class="pb-3">
                <span class="sr-only">Selecionar</span>
              </th>
              <th class="pb-3">Nº Pedido</th>
              <th class="pb-3">Cliente</th>
              <th class="pb-3">Data de Entrada</th>
              <th class="pb-3">Frete pré-verificado</th>
              <th class="pb-3">Status da proposta</th>
              <th class="pb-3 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-gray-100 text-gray-600">
            <% if (orcamentos && orcamentos.length> 0) { %>
              <% orcamentos.forEach(function(item) { %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 pr-3">
                    <input type="checkbox" class="orcamento-checkbox h-4 w-4 accent-green-800"
                      value="<%= item.codPedido %>" aria-label="Selecionar pedido <%= item.codPedido %>">
                  </td>
                  <td class="py-4 font-bold text-green-900">#<%= item.codPedido %>
                  </td>

                  <td class="py-4 font-medium text-gray-800">
                    <%= item.nomeCliente %>
                  </td>

                  <td class="py-4">
                    <%= item.dataEntrada || '---' %>
                  </td>

                  <td class="py-4">
                    <% if (item.freteGratisEstimado) { %>
                      <span class="font-semibold text-green-700">Grátis (cupom)</span>
                    <% } else if (item.valorFreteEstimado !== null && item.valorFreteEstimado !== undefined) { %>
                      <span class="font-semibold text-gray-800">R$ <%= Number(item.valorFreteEstimado).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                      <% if (item.prazoFreteEstimado) { %>
                        <span class="block text-xs text-gray-500"><%= item.prazoFreteEstimado %> dias úteis</span>
                      <% } %>
                    <% } else { %>
                      <span class="text-amber-700">Sem faixa para o CEP</span>
                    <% } %>
                  </td>

                  <td class="py-4">
                    <% if (item.statusOrcamento) { %>
                      <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= item.statusOrcamento === 'Aprovado' ? 'bg-green-100 text-green-800' : item.statusOrcamento === 'Recusado' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800' %>">
                        <%= item.statusOrcamento %>
                      </span>
                    <% } else { %>
                      <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">Aguardando avaliação</span>
                    <% } %>
                  </td>

                  <td class="py-4 text-right">
                    <a href="/admin/pedido/<%= item.codPedido %>/analisar"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg text-xs font-semibold transition-colors shadow-sm border border-blue-100">
                      <i class="bi bi-search text-xs"></i> Analisar
                    </a>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="py-8 text-center text-gray-400">Nenhum orçamento registrado.
                      </td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <script>
    const orcamentoCheckboxes = [...document.querySelectorAll(".orcamento-checkbox")];
    const selecionarTodosOrcamentos = document.getElementById("selecionarTodosOrcamentos");
    const analisarSelecionados = document.getElementById("analisarSelecionados");
    const resumoSelecaoOrcamentos = document.getElementById("resumoSelecaoOrcamentos");
    const atualizarSelecaoOrcamentos = () => {
      const selecionados = orcamentoCheckboxes.filter((checkbox) => checkbox.checked);
      if (selecionarTodosOrcamentos) {
        selecionarTodosOrcamentos.checked = orcamentoCheckboxes.length > 0 &&
          selecionados.length === orcamentoCheckboxes.length;
        selecionarTodosOrcamentos.indeterminate = selecionados.length > 0 &&
          selecionados.length < orcamentoCheckboxes.length;
      }
      if (analisarSelecionados) analisarSelecionados.disabled = selecionados.length === 0;
      if (resumoSelecaoOrcamentos) {
        resumoSelecaoOrcamentos.textContent = selecionados.length
          ? `${selecionados.length} pedido(s) selecionado(s). Cada análise será aberta em uma nova aba.`
          : "Selecione os pedidos que deseja analisar.";
      }
    };
    orcamentoCheckboxes.forEach((checkbox) => checkbox.addEventListener("change", atualizarSelecaoOrcamentos));
    selecionarTodosOrcamentos?.addEventListener("change", () => {
      orcamentoCheckboxes.forEach((checkbox) => {
        checkbox.checked = selecionarTodosOrcamentos.checked;
      });
      atualizarSelecaoOrcamentos();
    });
    analisarSelecionados?.addEventListener("click", () => {
      const selecionados = orcamentoCheckboxes.filter((checkbox) => checkbox.checked);
      let bloqueadas = 0;
      selecionados.forEach((checkbox) => {
        const aba = window.open(`/admin/pedido/${encodeURIComponent(checkbox.value)}/analisar`, "_blank");
        if (aba) {
          aba.opener = null;
          checkbox.checked = false;
        } else {
          bloqueadas += 1;
        }
      });
      atualizarSelecaoOrcamentos();
      if (bloqueadas) {
        resumoSelecaoOrcamentos.textContent =
          `${selecionados.length - bloqueadas} análise(s) aberta(s); ${bloqueadas} bloqueada(s). Permita pop-ups para este site e tente novamente.`;
      }
    });
    atualizarSelecaoOrcamentos();
  </script>
</body>

</html>