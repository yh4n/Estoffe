<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel Administrativo - Estoffe</title>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-stone-50 font-sans text-gray-800 antialiased">
  <%- include('_admin-nav') %>

  <main class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-green-800">Central de gestão</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Visão geral do sistema</h1>
      <p class="mt-2 text-gray-600">Pedidos, equipe, catálogo e produção reunidos em um só lugar.</p>
    </div>

    <% if (notificacao === 'enviada') { %>
      <div role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
        Status atualizado. O cliente recebeu um aviso por e-mail ou pela central de notificações do app.
      </div>
    <% } else if (notificacao === 'erro') { %>
      <div role="alert" class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        O status foi salvo, mas os avisos ao cliente não foram concluídos. Confira o cadastro e a configuração de e-mail.
      </div>
    <% } %>
    <% if (queryOfertaEnviada) { %>
      <div role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
        Oferta divulgada para <%= destinatariosOferta %> cliente(s) na central do app.
      </div>
    <% } %>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/admin/orcamentos"
        class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between hover:border-green-500 hover:shadow-md transition-all duration-200 group cursor-pointer">
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase">Novos Orçamentos</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">
            <%= totalOrcamentos %>
          </p>
        </div>
        <div
          class="w-12 h-12 bg-green-100 group-hover:bg-green-700 group-hover:text-white rounded-lg flex items-center justify-center text-green-700 text-xl transition-colors">
          <i class="bi bi-file-earmark-text"></i>
        </div>
      </a>

      <a href="/admin/producao"
        class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between hover:border-green-600 hover:shadow-md transition-all duration-200 group cursor-pointer">
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase">Concluídos</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">
            <%= totalConcluidos %>
          </p>
        </div>
        <div
          class="w-12 h-12 bg-green-100 group-hover:bg-green-600 group-hover:text-white rounded-lg flex items-center justify-center text-green-700 text-xl transition-colors">
          <i class="bi bi-check2-all"></i>
        </div>
      </a>

      <a href="/admin/estofadores"
        class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between hover:border-blue-400 hover:shadow-md transition-all duration-200 group cursor-pointer">
        <div>
          <p class="text-sm font-medium text-gray-500 uppercase">Estofadores Ativos</p>
          <p class="text-3xl font-bold text-gray-800 mt-1">
            <%= totalEstofadores %>
          </p>
        </div>
        <div
          class="w-12 h-12 bg-blue-100 group-hover:bg-blue-600 group-hover:text-white rounded-lg flex items-center justify-center text-blue-700 text-xl transition-colors">
          <i class="bi bi-people"></i>
        </div>
      </a>
    </div>

    <section class="mb-8 rounded-xl border border-amber-200 bg-white p-6 shadow-sm">
      <h2 class="font-bold text-gray-800"><i class="bi bi-megaphone mr-2 text-amber-700"></i>Divulgar uma oferta</h2>
      <p class="mt-1 text-sm text-gray-600">A oferta aparece na central do app dos clientes, junto das atualizações e novidades da loja.</p>
      <form action="/admin/notificacoes/oferta" method="POST" class="mt-4 grid gap-3 md:grid-cols-[minmax(12rem,1fr)_2fr_auto] md:items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="text-xs font-semibold text-gray-600">Título
          <input required maxlength="120" name="titulo" placeholder="Ex.: Novidades Estoffe"
            class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
        </label>
        <label class="text-xs font-semibold text-gray-600">Mensagem da oferta
          <textarea required maxlength="1000" name="mensagem" rows="2" placeholder="Conte aos clientes sobre a oferta..."
            class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm"></textarea>
        </label>
        <button type="submit" class="rounded-md bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">
          <i class="bi bi-send mr-1" aria-hidden="true"></i>Divulgar oferta
        </button>
      </form>
    </section>
    <script>
      const formularioOferta = document.querySelector('form[action="/admin/notificacoes/oferta"]');
      const mensagemOferta = formularioOferta?.querySelector('textarea[name="mensagem"]');
      mensagemOferta?.addEventListener("input", () => mensagemOferta.setCustomValidity(""));
      formularioOferta?.addEventListener("submit", (event) => {
        if (mensagemOferta && !mensagemOferta.value.trim()) {
          event.preventDefault();
          mensagemOferta.setCustomValidity("Escreva uma mensagem antes de divulgar a oferta.");
          mensagemOferta.reportValidity();
        }
      });
    </script>


    <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
        <h3 class="font-bold text-gray-700">Pagamentos aprovados aguardando atribuição</h3>
        <span class="rounded-full bg-green-100 px-3 py-1 text-sm font-bold text-green-900"><%= pedidosPagos.length %></span>
      </div>
      <div class="p-6 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-200">
              <th class="pb-3">Nº Pedido</th>
              <th class="pb-3">Cliente</th>
              <th class="pb-3">Data do pedido</th>
              <th class="pb-3">Estofador responsável</th>
              <th class="pb-3 text-right">Ação</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-gray-100 text-gray-600">
            <% if (pedidosPagos.length > 0) { %>
              <% pedidosPagos.forEach(function(pedido) { %>
                <tr>
                  <td class="py-4 font-bold text-green-900">#<%= pedido.codPedido %></td>
                  <td class="py-4 font-medium text-gray-800"><%= pedido.nomeCliente %></td>
                  <td class="py-4"><%= pedido.dataPedido ? new Date(pedido.dataPedido).toLocaleDateString('pt-BR') : '---' %></td>
                  <td class="py-4">
                    <form id="atribuir-pedido-<%= pedido.codPedido %>" action="/admin/pedido/<%= pedido.codPedido %>/status" method="POST" class="flex items-center gap-2">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="novoStatus" value="Em Produção">
                      <select name="codEstofador" required class="w-full min-w-48 px-2 py-2 bg-white border border-gray-300 rounded-md text-sm text-gray-700">
                        <option value="" disabled selected>Selecione um estofador</option>
                        <% listaEstofadores.forEach(function(estofador) { %>
                          <option value="<%= estofador.codUsuario %>"><%= estofador.nome %></option>
                        <% }); %>
                      </select>
                    </form>
                  </td>
                  <td class="py-4 text-right">
                    <button type="submit" form="atribuir-pedido-<%= pedido.codPedido %>" class="px-3 py-2 bg-green-800 hover:bg-green-700 text-white rounded-md text-sm font-medium disabled:opacity-50" <%= listaEstofadores.length === 0 ? 'disabled' : '' %>>
                      Atribuir e iniciar
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-8 text-center text-gray-400">Nenhum pagamento aprovado aguardando atribuição.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h3 class="font-bold text-gray-700">Últimas Ordens de Serviço</h3>
      </div>
      <div class="p-6 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-200">
              <th class="pb-3">Nº Pedido</th>
              <th class="pb-3">Cliente</th>
              <th class="pb-3">Data de Entrada</th>
              <th class="pb-3">Estofador Responsável</th>
              <th class="pb-3 text-right">Status</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-gray-100 text-gray-600">
            <% if (ordensServico && ordensServico.length> 0) { %>
              <% ordensServico.forEach(function(ordem) { %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 font-bold text-green-900">#<%= ordem.codPedido %>
                  </td>
                  <td class="py-4 font-medium text-gray-800">
                    <%= ordem.nomeCliente %>
                  </td>
                  <td class="py-4">
                    <%= ordem.dataPedido ? new Date(ordem.dataPedido).toLocaleDateString('pt-BR') : '---' %>
                  </td>
                  <td class="py-4 text-gray-500">
                    <%= ordem.nomeEstofador || 'Não atribuído' %>
                  </td>

                  <td class="py-4 text-right">
                    <% var statusLimpo=ordem.status ? ordem.status.trim().toLowerCase() : '' ; %>

                      <% if (statusLimpo==='em produção' || statusLimpo==='em producao' ) { %>
                        <span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-medium">Na
                          Oficina</span>
                        <% } else if (statusLimpo==='pronto' ) { %>
                          <span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-1 rounded-full font-medium">Pronto
                            para Entrega</span>
                          <% } else if (statusLimpo==='entregue' ) { %>
                            <span
                              class="bg-green-100 text-green-800 text-xs px-2.5 py-1 rounded-full font-medium">Entregue</span>
                            <% } else if (statusLimpo==='cancelado' ) { %>
                              <span
                                class="bg-red-100 text-red-800 text-xs px-2.5 py-1 rounded-full font-medium">Cancelado</span>
                              <% } else { %>
                                <span class="bg-gray-100 text-gray-800 text-xs px-2.5 py-1 rounded-full font-medium">
                                  <%= ordem.status %>
                                </span>
                                <% } %>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="py-8 text-center text-gray-400">Nenhuma ordem de serviço registrada no
                        momento.</td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

</body>

</html>