<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos cadastrados - Estoffe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="min-h-screen bg-stone-50 text-gray-800 antialiased">
    <%- include('_admin-nav') %>

    <main class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-green-800">Catálogo</p>
                <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Produtos da loja</h1>
                <p class="mt-2 text-gray-600">Gerencie preços, promoções e ofertas do catálogo.</p>
            </div>
            <a href="/admin/produtos/novo" class="inline-flex items-center justify-center gap-2 rounded-xl bg-green-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-green-800">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>Novo produto
            </a>
        </div>
        <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="mb-5">
                <h2 class="text-lg font-bold text-green-950">Criar código promocional</h2>
                <p class="mt-1 text-sm text-gray-500">O código <strong>ESTOFFE10</strong> já está ativo e concede 10% de desconto.</p>
            </div>
            <form action="/admin/codigos-promocionais" method="POST" class="grid gap-3 md:grid-cols-[1fr_160px_180px_auto] md:items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="text-sm font-semibold text-gray-700">Código
                    <input required name="codigo" maxlength="40" pattern="[A-Za-z0-9_-]{3,40}" placeholder="VERAO15"
                        class="mt-1 w-full rounded border border-gray-300 p-2 uppercase">
                </label>
                <label class="text-sm font-semibold text-gray-700">Desconto (%)
                    <input required type="number" name="percentual" min="0.01" max="99.99" step="0.01" placeholder="15"
                        class="mt-1 w-full rounded border border-gray-300 p-2">
                </label>
                <label class="text-sm font-semibold text-gray-700">Validade (opcional)
                    <input type="date" name="validade" class="mt-1 w-full rounded border border-gray-300 p-2">
                </label>
                <label class="flex items-center gap-2 pb-2 text-sm font-semibold text-gray-700">
                    <input type="checkbox" name="freteGratis" class="h-4 w-4 accent-green-800">
                    Frete grátis
                </label>
                <button type="submit" class="rounded bg-green-800 px-4 py-2 font-medium text-white hover:bg-green-700">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> Criar código
                </button>
            </form>
            <div class="mt-5 flex flex-wrap gap-2">
                <% codigosPromocionais.forEach((codigo) => { %>
                    <span class="rounded-full <%= codigo.ativo ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500' %> px-3 py-1 text-xs font-semibold">
                        <%= codigo.codigo %> - <%= Number(codigo.percentual).toLocaleString('pt-BR') %>%
                        <%= codigo.frete_gratis ? '+ frete grátis' : '' %>
                        <%= codigo.validade ? `até ${new Date(codigo.validade).toLocaleDateString('pt-BR')}` : 'sem validade' %>
                    </span>
                <% }) %>
            </div>
        </section>

        <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="mb-5">
                <h2 class="text-lg font-bold text-green-950">Promoção em produtos selecionados</h2>
                <p class="mt-1 text-sm text-gray-500">Selecione os produtos, informe o desconto e aplique a mesma promoção a todos.</p>
            </div>
            <form action="/admin/produtos/promocao" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <label class="block text-sm font-semibold text-gray-700">
                        Desconto percentual
                        <div class="mt-1 flex items-center gap-2">
                            <input required type="number" name="percentualPromocao" min="1" max="99" step="0.01" placeholder="10"
                                class="w-32 rounded border border-gray-300 p-2">
                            <span class="text-gray-500">%</span>
                        </div>
                    </label>
                    <button name="acao" value="ativar" type="submit" class="rounded bg-green-800 px-4 py-2 font-medium text-white hover:bg-green-700">
                        <i class="bi bi-tag" aria-hidden="true"></i> Aplicar promoção
                    </button>
                    <button name="acao" value="remover" type="submit" class="rounded bg-gray-700 px-4 py-2 font-medium text-white hover:bg-gray-600">
                        <i class="bi bi-tag-fill" aria-hidden="true"></i> Remover promoção
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <caption class="sr-only">Produtos disponíveis para promoção</caption>
                        <thead>
                            <tr class="border-b text-gray-500">
                                <th scope="col" class="p-2"><span class="sr-only">Selecionar</span></th>
                                <th scope="col" class="p-2">Produto</th>
                                <th scope="col" class="p-2">Categoria</th>
                                <th scope="col" class="p-2">Preço atual</th>
                                <th scope="col" class="p-2">Promoção</th>
                                <th scope="col" class="p-2 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% produtos.forEach((produto) => { %>
                                <tr class="border-b last:border-0 hover:bg-gray-50">
                                    <td class="p-2">
                                        <input type="checkbox" name="produtoIds" value="<%= produto.codProduto %>" aria-label="Selecionar <%= produto.nome %>" class="h-4 w-4 accent-green-800">
                                    </td>
                                    <td class="p-2 font-semibold"><%= produto.nome %></td>
                                    <td class="p-2 text-gray-500"><%= produto.nome_categoria || 'Sem categoria' %></td>
                                    <td class="p-2 tabular-nums">
                                        <% if (produto.promocao_ativa && produto.preco_promocional) { %>
                                            <span class="text-xs text-gray-400 line-through">R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                            <span class="block font-bold text-green-800">R$ <%= Number(produto.preco_atual).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                        <% } else { %>
                                            R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                        <% } %>
                                    </td>
                                    <td class="p-2">
                                        <% if (produto.promocao_ativa && produto.preco_promocional) { %>
                                            <span class="rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Ativa</span>
                                        <% } else { %>
                                            <span class="text-xs text-gray-400">Sem promoção</span>
                                        <% } %>
                                    </td>
                                    <td class="p-2 text-right">
                                        <a href="/admin/produtos/<%= produto.codProduto %>/editar" class="inline-flex items-center gap-1 rounded border border-green-800 px-3 py-1.5 text-xs font-semibold text-green-900 hover:bg-green-50">
                                            <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% if (!produtos.length) { %>
                    <p class="py-6 text-center text-gray-500">Nenhum produto cadastrado.</p>
                <% } %>
            </form>
        </section>
    </main>
</body>

</html>
