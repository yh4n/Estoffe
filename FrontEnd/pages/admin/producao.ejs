<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Em Produção - Estoffe Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="min-h-screen bg-stone-50 text-gray-800 antialiased">
  <%- include('_admin-nav') %>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="mb-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-green-800">Operação</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Produção</h1>
      <p class="mt-2 text-gray-600">Atribua responsáveis, organize a agenda e acompanhe cada pedido.</p>
    </div>

    <% if (notificacao === 'enviada') { %>
      <div role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-800">
        Agendamento ou status atualizado. O cliente recebeu um aviso por e-mail ou pela central de notificações do app.
      </div>
    <% } else if (notificacao === 'erro') { %>
      <div role="alert" class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        Os dados foram salvos, mas os avisos ao cliente não foram concluídos. Verifique o cadastro e a configuração de e-mail.
      </div>
    <% } %>

    <section class="mb-6" aria-labelledby="resumo-producao">
      <h2 id="resumo-producao" class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500">
        Carga de trabalho por funcionário
      </h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% if (resumoProducao.length) { %>
          <% resumoProducao.forEach(function(grupo) { %>
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
              <p class="font-semibold text-gray-800"><i class="bi bi-person-gear mr-1 text-blue-700"></i><%= grupo.nomeEstofador %></p>
              <p class="mt-1 text-sm text-gray-500"><%= grupo.totalPedidos %> pedido(s) em produção</p>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-sm text-gray-500">Nenhum pedido está em produção neste momento.</p>
        <% } %>
      </div>
    </section>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="p-6 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="text-xs font-semibold text-gray-500 uppercase border-b border-gray-200">
              <th class="pb-3">Nº Pedido</th>
              <th class="pb-3">Cliente</th>
              <th class="pb-3">Data de Entrada</th>
              <th class="pb-3">Agendamento de Coleta e Entrega</th>
              <th class="pb-3">Produção por Funcionário</th>
              <th class="pb-3">Status</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-gray-100 text-gray-600">
            <% if (pedidosProducao && pedidosProducao.length> 0) { %>
              <% pedidosProducao.forEach(function(item) { %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 pr-4 font-bold text-green-900">
                    #<%= item.codPedido %>
                    <a href="/admin/estofador-analisa/<%= item.codPedido %>"
                      class="mt-1 block whitespace-nowrap text-xs font-medium text-blue-700 hover:text-blue-900">
                      <i class="bi bi-eye mr-1"></i>Ver produtos
                    </a>
                  </td>
                  <td class="py-4 pr-4 font-medium text-gray-800">
                    <%= item.nomeCliente %>
                  </td>
                  <td class="py-4 pr-4 whitespace-nowrap">
                    <%= item.dataPedidoFormatada ? item.dataPedidoFormatada.split('-').reverse().join('/') : '---' %>
                  </td>

                  <td class="py-4 pr-4 min-w-64">
                    <form action="/admin/pedido/<%= item.codPedido %>/agenda" method="POST" class="space-y-2">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <label class="flex items-center gap-2 text-xs">
                        <span class="w-16 shrink-0">Coleta</span>
                        <input type="date" name="dataColeta" value="<%= item.dataColetaFormatada || '' %>"
                          class="min-w-0 rounded-md border border-gray-300 px-2 py-1.5">
                      </label>
                      <label class="flex items-center gap-2 text-xs">
                        <span class="w-16 shrink-0">Entrega</span>
                        <input type="date" name="dataEntrega" value="<%= item.dataEntregaFormatada || '' %>"
                          class="min-w-0 rounded-md border border-gray-300 px-2 py-1.5">
                      </label>
                      <button type="submit" class="rounded-md bg-green-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-green-800">
                        <i class="bi bi-bell mr-1" aria-hidden="true"></i>Salvar e avisar cliente
                      </button>
                    </form>
                  </td>

                  <td class="py-4 pr-4 min-w-48">
                    <% if (item.status === 'Em Produção') { %>
                      <form action="/admin/pedido/<%= item.codPedido %>/estofador" method="POST" class="space-y-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <select name="codEstofador" required class="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs">
                          <% if (!estofadores.length) { %>
                            <option value="">Cadastre um estofador</option>
                          <% } else { %>
                            <% estofadores.forEach(function(estofador) { %>
                              <option value="<%= estofador.codUsuario %>" <%= Number(item.codEstofador) === Number(estofador.codUsuario) ? 'selected' : '' %>>
                                <%= estofador.nome %>
                              </option>
                            <% }); %>
                          <% } %>
                        </select>
                        <button type="submit" <%= estofadores.length ? '' : 'disabled' %>
                          class="rounded-md border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800 hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-50">
                          <i class="bi bi-person-gear"></i> Atribuir responsável
                        </button>
                      </form>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 rounded-md bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700">
                        <i class="bi bi-person-gear"></i><%= item.nomeEstofador || 'Não definido' %>
                      </span>
                    <% } %>
                  </td>

                  <td class="py-4">
                    <% var statusAtual=item.status ? item.status.trim() : '' ; %>

                      <form action="/admin/pedido/<%= item.codPedido %>/status" method="POST" class="inline-flex items-center gap-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <select name="novoStatus" required onchange="this.form.submit()"
                          class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 focus:outline-none focus:border-amber-500 cursor-pointer">

                          <option value="" disabled <%=(statusAtual !=='Pronto' && statusAtual !=='Entregue' )
                            ? 'selected' : '' %>>
                            Status Atual: <%= item.status %>
                          </option>

                          <% if (statusAtual==='Em Produção' ) { %>
                            <option value="Pronto">🎉 Marcar como Pronto</option>
                            <option value="Cancelado">❌ Cancelar Pedido</option>
                            <% } %>

                              <% if (statusAtual==='Pronto' ) { %>
                                <option value="Pronto" selected disabled>Pronto para Entrega</option>
                                <option value="Entregue">Marcar como Entregue</option>
                                <% } %>

                                  <% if (statusAtual==='Entregue' ) { %>
                                    <option value="Entregue" selected disabled>Entregue ao Cliente</option>
                                    <% } %>

                        </select>
                      </form>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="py-8 text-center text-gray-400">Nenhum serviço em produção neste momento.
                      </td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>

</html>