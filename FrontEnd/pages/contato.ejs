<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contato - Estoffe</title>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="/../css/style.css">
</head>


<body>
  <!-- ========================================== -->
  <!--             HEADER / MENU / MOBILE         -->
  <!-- ========================================== -->

  <%- include('_navbar') %>

    <section class="relative bg-green-950 text-white pt-50 pb-40  px-8 md:px-25 lg:px-33 overflow-hidden">
      <div class="absolute inset-0 opacity-5 pointer-events-none flex items-center justify-center">
        <span class="text-[24vw] text-white font-serif font-bold italic select-none">Estoffe</span>
      </div>

      <div
        class="max-w-7xl mx-auto relative z-10 text-center md:text-left flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.6em] text-green-400 mb-3 block">Contato</span>
          <h1 class="text-5xl md:text-7xl font-light tracking-tight">Alta <span
              class="font-extrabold text-white">Tapeçaria</span></h1>
          <div class="w-16 h-[2px] bg-green-400 mt-4 mx-auto md:mx-0"></div>
        </div>
        <p class="text-gray-300 font-light max-w-md text-sm md:text-base leading-relaxed">
          Envie sua mensagem e traga sua demanda para a ESTOFFE. Garantimos suporte especializado e assessoria na
          escolha de materiais para entregar a máxima qualidade ao seu espaço.
        </p>
      </div>
    </section>

    <main class="py-20 px-6 md:px-16 lg:px-24 flex-grow">
      <div>
        <h2 class="text-3xl font-bold text-center mb-12">Faça seu Orçamento</h2>
        <% if (sucesso) { %>
          <p role="status" class="max-w-3xl mx-auto mb-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-900">
            Mensagem enviada. Nossa equipe entrará em contato em breve.
          </p>
        <% } %>
        <div class="max-w-3xl mx-auto bg-green-100/10 p-8 rounded-lg shadow-lg">
          <form action="/contato/enviar" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="contato-nome" class="block text-sm font-semibold text-gray-700">Nome</label>
              <input id="contato-nome" type="text" name="nome" required
                class="w-full border border-gray-300 p-3 rounded-md focus:outline-green-700">
            </div>

            <div>
              <label for="contato-email" class="block text-sm font-semibold text-gray-700">E-mail</label>
              <input id="contato-email" type="email" name="email" required
                class="w-full border border-gray-300 p-3 rounded-md focus:outline-green-700">
            </div>

            <div>
              <label for="contato-mensagem" class="block text-sm font-semibold text-gray-700">Mensagem</label>
              <textarea id="contato-mensagem" name="mensagem" required rows="4"
                class="w-full border border-gray-300 p-3 rounded-md focus:outline-green-700"></textarea>
            </div>

            <button type="submit"
              class="px-6 py-3 bg-green-900 hover:bg-green-700 text-white font-semibold rounded-md transition-colors duration-300 cursor-pointer">
              Enviar Mensagem
            </button>
          </form>
        </div>
      </div>
    </main>

    <%- include('_mascote', {
      mascotes: [
        { nome: 'Estoffinho', imagem: 'estoffinho.png' },
        { nome: 'Nino', imagem: 'nino.png' }
      ],
      mensagem: 'O Estoffinho e o Nino estão aqui para ajudar. Envie sua mensagem e nossa equipe falará com você.'
    }) %>

    <footer class="bg-green-950 text-gray-400 text-sm py-12 px-6 md:px-16 lg:px-24 border-t border-green-900">
      <div
        class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div>
          <p class="text-white font-bold text-lg tracking-wider uppercase">Estoffe</p>
          <p class="text-xs text-gray-400 mt-1">&copy; 2026 Estoffe Estofaria Premium. Todos os direitos reservados.</p>
        </div>

        <div class="flex space-x-6 text-xl">
          <a href="#" class="hover:text-white transition-colors duration-300"><i class="bi bi-instagram"></i></a>
          <a href="#" class="hover:text-white transition-colors duration-300"><i class="bi bi-facebook"></i></a>
          <a href="#" class="hover:text-white transition-colors duration-300"><i class="bi bi-whatsapp"></i></a>
        </div>
      </div>
    </footer>

    <script src="/pages/animacoes/anima_gerais.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
      integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
      crossorigin="anonymous"></script>
</body>

</html>