<header id="main-header"
    class="fixed left-0 top-0 z-50 w-full border-b border-white/10 bg-green-950 px-4 py-3 text-white shadow-lg shadow-green-950/10 transition-all duration-300 sm:px-6">
    <% const caminhoAtual = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <% const usuarioLogado = typeof usuario !== 'undefined' ? usuario : null; %>
    <% const clienteLogado = Boolean(usuarioLogado && usuarioLogado.tipo === 'cliente'); %>
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4">
        <a id="header-logo" href="/" class="flex shrink-0 items-center" aria-label="Estoffe, página inicial">
            <img id="logo-img" src="/image/LogoNavBar.png" alt="Estoffe"
                class="h-12 w-auto transition-all duration-300 sm:h-14">
        </a>

        <button id="menu-btn" type="button"
            class="relative z-50 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/20 text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-300 md:hidden"
            aria-label="Abrir menu" aria-controls="menu" aria-expanded="false">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path class="menu-icon-line" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16"></path>
                <path class="menu-icon-line" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16"></path>
                <path class="menu-icon-line" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16"></path>
            </svg>
        </button>

        <nav id="menu"
            class="fixed inset-0 z-40 flex h-screen w-full -translate-y-2 flex-col items-stretch justify-start overflow-y-auto bg-green-950/95 px-5 pb-8 pt-24 opacity-0 shadow-xl shadow-green-950/20 backdrop-blur-md transition-all duration-300 pointer-events-none md:static md:h-auto md:w-auto md:translate-y-0 md:flex-row md:items-center md:justify-end md:overflow-visible md:bg-transparent md:p-0 md:opacity-100 md:shadow-none md:backdrop-blur-none md:pointer-events-auto">
            <ul class="flex w-full flex-col items-stretch gap-2 text-base font-medium md:w-auto md:flex-row md:items-center md:gap-1">
                <li>
                    <a href="/"
                        class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                        <% if (caminhoAtual === '/') { %>data-active="true" aria-current="page"<% } %>>
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>Início</span>
                    </a>
                </li>
                <li>
                    <a href="/produtos"
                        class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/produtos' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                        <% if (caminhoAtual === '/produtos') { %>data-active="true" aria-current="page"<% } %>>
                        <i class="bi bi-shop" aria-hidden="true"></i><span>Produtos</span>
                    </a>
                </li>
                <li>
                    <a href="/produtos-sob-medida"
                        class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/produtos-sob-medida' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                        <% if (caminhoAtual === '/produtos-sob-medida') { %>data-active="true" aria-current="page"<% } %>>
                        <i class="bi bi-rulers" aria-hidden="true"></i><span>Sob medida</span>
                    </a>
                </li>
                <li>
                    <a href="/sobre"
                        class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/sobre' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                        <% if (caminhoAtual === '/sobre') { %>data-active="true" aria-current="page"<% } %>>
                        <i class="bi bi-info-circle" aria-hidden="true"></i><span>Sobre</span>
                    </a>
                </li>
                <li>
                    <a href="/contato"
                        class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/contato' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                        <% if (caminhoAtual === '/contato') { %>data-active="true" aria-current="page"<% } %>>
                        <i class="bi bi-chat-dots" aria-hidden="true"></i><span>Contato</span>
                    </a>
                </li>

                <% if (usuarioLogado) { %>
                    <% if (clienteLogado) { %>
                        <li>
                            <a href="/client-dashboard#pedidos"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/client-dashboard' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                                <% if (caminhoAtual === '/client-dashboard') { %>data-active="true" aria-current="page"<% } %>>
                                <i class="bi bi-receipt" aria-hidden="true"></i><span>Meus pedidos</span>
                            </a>
                        </li>
                        <li>
                            <a href="/notificacoes"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/notificacoes' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                                <% if (caminhoAtual === '/notificacoes') { %>data-active="true" aria-current="page"<% } %>>
                                <i class="bi bi-bell" aria-hidden="true"></i><span>Notificações</span>
                            </a>
                        </li>
                        <li>
                            <a href="/perfil"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition <%= caminhoAtual === '/perfil' ? 'bg-white/10 font-semibold text-white' : 'text-green-100 hover:bg-white/10 hover:text-white' %>"
                                <% if (caminhoAtual === '/perfil') { %>data-active="true" aria-current="page"<% } %>>
                                <i class="bi bi-person-circle" aria-hidden="true"></i><span>Meu perfil</span>
                            </a>
                        </li>
                    <% } else if (usuarioLogado.tipo === 'admin') { %>
                        <li>
                            <a href="/admin-dashboard"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition text-green-100 hover:bg-white/10 hover:text-white">
                                <i class="bi bi-shield-lock" aria-hidden="true"></i><span>Painel administrativo</span>
                            </a>
                        </li>
                        <li>
                            <a href="/notificacoes"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition text-green-100 hover:bg-white/10 hover:text-white">
                                <i class="bi bi-bell" aria-hidden="true"></i><span>Notificações</span>
                            </a>
                        </li>
                    <% } else if (usuarioLogado.tipo === 'estofador') { %>
                        <li>
                            <a href="/estofador-dashboard"
                                class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition text-green-100 hover:bg-white/10 hover:text-white">
                                <i class="bi bi-tools" aria-hidden="true"></i><span>Oficina</span>
                            </a>
                        </li>
                    <% } %>
                    <li class="pt-2 md:pt-0">
                        <form action="/logout" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit"
                            class="nav-link-item !ml-0 flex w-full items-center gap-2 rounded-lg border border-white/15 px-3 py-2.5 text-green-100 transition hover:border-red-200/30 hover:bg-red-500/10 hover:text-white md:ml-1">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sair</span>
                            </button>
                        </form>
                    </li>
                <% } else { %>
                    <li>
                        <a href="/login"
                            class="nav-link-item !ml-0 flex items-center gap-2 rounded-lg px-3 py-2.5 transition text-green-100 hover:bg-white/10 hover:text-white">
                            <i class="bi bi-person" aria-hidden="true"></i><span>Entrar</span>
                        </a>
                    </li>
                <% } %>
            </ul>

            <% if (!usuarioLogado || clienteLogado) { %>
                <a href="/carrinho"
                    class="relative !ml-0 mt-3 flex h-12 items-center justify-center gap-2 rounded-xl border border-white/20 px-4 text-green-50 transition hover:bg-white/10 md:ml-2 md:mt-0"
                    aria-label="Carrinho de compras">
                    <i class="bi bi-bag text-lg" aria-hidden="true"></i>
                    <span class="text-sm font-medium md:hidden">Carrinho</span>
                    <span id="cart-count"
                        class="flex h-5 min-w-5 items-center justify-center rounded-full bg-amber-400 px-1 text-[10px] font-bold text-green-950 <%= Number(typeof cartCount !== 'undefined' ? cartCount : 0) > 0 ? '' : 'hidden' %>">
                        <%= typeof cartCount !== 'undefined' ? cartCount : 0 %>
                    </span>
                </a>
            <% } %>
        </nav>
    </div>
</header>
<script src="/pages/nav-mobile.js" defer></script>
