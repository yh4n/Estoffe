<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produto.nome %> - Estoffe</title>
    <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/../css/style.css">
</head>

<body class="bg-gray-50 text-gray-800">
    <%- include('_navbar') %>
<br>
<br>
<br>
<br>
<br>
    <main class="max-w-7xl mx-auto px-6 py-10 md:px-12">
        <div class="mb-6">
            <a href="/produtos" class="inline-flex items-center gap-2 text-sm font-semibold text-green-900 hover:text-green-700">
                <i class="bi bi-arrow-left"></i> Voltar para produtos
            </a>
        </div>

        <%- include('_mascote', {
        mascotes: [{ nome: 'Estoffinho', imagem: 'estoffinho.png' }],
        mensagem: 'O Estoffinho lembra: um bom estofado merece atenção aos detalhes. Confira as informações da peça antes de adicionar ao carrinho.'
    }) %>

        <section class="bg-white border border-gray-100 shadow-sm rounded-sm overflow-hidden" data-purchase-card>
            <div class="grid grid-cols-1 lg:grid-cols-2">
                <div class="bg-gray-100 p-6 md:p-10">
                    <div class="aspect-square overflow-hidden rounded-sm border border-gray-200 bg-white mb-4">
                        <button id="abrir-zoom" type="button" class="group relative block h-full w-full cursor-zoom-in" aria-label="Ampliar imagem de <%= produto.nome %>">
                            <img id="imagem-principal" src="<%= produto.galeria && produto.galeria[0] ? produto.galeria[0] : produto.imagem %>" alt="<%= produto.nome %>" class="h-full w-full object-cover object-center">
                            <span class="absolute bottom-3 right-3 inline-flex items-center gap-2 rounded-sm bg-white/90 px-3 py-2 text-xs font-semibold text-green-950 shadow transition group-hover:bg-white">
                                <i class="bi bi-zoom-in" aria-hidden="true"></i> Ampliar imagem
                            </span>
                        </button>
                    </div>

                    <dialog id="zoom-dialog" class="m-auto max-h-[95vh] max-w-[95vw] rounded-sm border-0 bg-transparent p-0 backdrop:bg-black/80">
                        <div class="relative flex max-h-[95vh] max-w-[95vw] items-center justify-center">
                            <button id="fechar-zoom" type="button" class="absolute right-3 top-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl text-green-950 shadow hover:bg-gray-100" aria-label="Fechar imagem ampliada">
                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                            </button>
                            <img id="imagem-ampliada" src="" alt="" class="max-h-[95vh] max-w-[95vw] rounded-sm object-contain">
                        </div>
                    </dialog>

                    <% if (produto.galeria && produto.galeria.length > 1) { %>
                        <div class="flex flex-wrap gap-3">
                            <% produto.galeria.forEach((imagem, index) => { %>
                                <button type="button" class="thumbnail-btn h-20 w-20 overflow-hidden rounded border <%= index === 0 ? 'border-green-900 ring-2 ring-green-200' : 'border-gray-200' %>" data-imagem="<%= imagem %>" aria-label="Ver imagem <%= index + 1 %>">
                                    <img src="<%= imagem %>" alt="<%= produto.nome %> - imagem <%= index + 1 %>" class="h-full w-full object-cover">
                                </button>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="p-6 md:p-10 flex flex-col justify-center">
                    <div class="mb-4 flex flex-wrap items-center gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-[0.28rem] text-green-700">Estoffe</span>
                        <% if (produto.nome_categoria) { %>
                            <span class="rounded-full bg-green-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-green-800">
                                <%= produto.nome_categoria %>
                            </span>
                        <% } %>
                        <% if (produto.sob_medida) { %>
                            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-amber-800">
                                Compra sob medida / sem estoque
                            </span>
                        <% } %>
                    </div>

                    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"><%= produto.nome %></h1>

                    <div class="mb-5">
                        <% if (produto.promocao_ativa && Number(produto.preco_atual) < Number(produto.preco)) { %>
                            <div class="flex items-center gap-3 flex-wrap">
                                <span class="text-gray-400 line-through text-lg">R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                                <span class="text-3xl font-extrabold text-red-700">R$ <%= Number(produto.preco_atual).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                            </div>
                        <% } else { %>
                            <p class="text-3xl font-extrabold text-green-950">R$ <%= Number(produto.preco).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></p>
                        <% } %>
                    </div>

                    <p class="text-base leading-relaxed text-gray-600 mb-6">
                        <%= produto.descricao || 'Peça exclusiva da linha Estoffe, desenvolvida para unir conforto, durabilidade e acabamento premium em um design sofisticado.' %>
                    </p>

                    <% if (materiais && materiais.length) { %>
                        <div class="mb-6">
                            <h2 class="text-xs font-bold uppercase tracking-[0.25rem] text-gray-500 mb-3">Materiais utilizados</h2>
                            <ul class="space-y-2 text-sm text-gray-700">
                                <% materiais.forEach((material) => { %>
                                    <li class="flex items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-green-700"></i>
                                        <span><%= material.nome %> • <%= Number(material.quantidadeUsada).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>

                    <form action="/carrinho/add/<%= produto.codProduto %>" method="POST" data-purchase-container data-offline-cart-form data-authenticated="<%= usuario ? 'true' : 'false' %>" data-product-id="<%= produto.codProduto %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-green-950 hover:bg-green-800 text-white font-semibold px-6 py-3 rounded-sm uppercase tracking-wider text-xs transition-colors duration-300">
                            <i class="bi bi-bag-plus"></i> <%= produto.sob_medida ? 'Comprar' : 'Colocar no Carrinho' %>
                        </button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    

    <script src="/pages/animacoes/anima_gerais.js"></script>
    <script src="/pages/js/carrinho-offline.js" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const principal = document.getElementById('imagem-principal');
            const botoes = document.querySelectorAll('.thumbnail-btn');
            const abrirZoom = document.getElementById('abrir-zoom');
            const dialogZoom = document.getElementById('zoom-dialog');
            const imagemAmpliada = document.getElementById('imagem-ampliada');
            const fecharZoom = document.getElementById('fechar-zoom');
            if (!principal || !abrirZoom || !dialogZoom || !imagemAmpliada || !fecharZoom) return;

            abrirZoom.addEventListener('click', () => {
                imagemAmpliada.src = principal.src;
                imagemAmpliada.alt = principal.alt;
                dialogZoom.showModal();
            });

            fecharZoom.addEventListener('click', () => dialogZoom.close());

            dialogZoom.addEventListener('click', (evento) => {
                if (evento.target === dialogZoom) dialogZoom.close();
            });

            botoes.forEach((botao) => {
                botao.addEventListener('click', () => {
                    const imagem = botao.dataset.imagem;
                    if (!imagem) return;
                    principal.src = imagem;
                    botoes.forEach((btn) => {
                        const ativo = btn === botao;
                        btn.classList.toggle('border-green-900', ativo);
                        btn.classList.toggle('ring-2', ativo);
                        btn.classList.toggle('ring-green-200', ativo);
                        btn.classList.toggle('border-gray-200', !ativo);
                    });
                });
            });
        });
    </script>
</body>

</html>
