<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96">

  <title>Registrar - Estoffe</title>

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Tailwind -->
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/register.css">

</head>

<body>
  <!-- =========================
         CADASTRO
    ========================== -->

  <main class="register-page">


    <!-- =====================
             LADO DA MARCA
        ====================== -->

    <section class="register-brand">

      <div class="brand-content">

        <div class="sofa-area">

          <!-- SOFÁ -->

          <img src="/image/LogoNavBar.png" class="sofa-image" alt="Sofá Estoffe">


          <!-- ESTOFFINHO -->

          <img src="/image/Novo_grupo/nino.png" class="bear-image" alt="Nino">


        </div>


        <div class="brand-text">

          <h1>Estoffe</h1>

          <p>
            Crie sua conta e faça parte
            da experiência Estoffe.
          </p>

        </div>

      </div>

    </section>



    <!-- =====================
             FORMULÁRIO
        ====================== -->

    <section class="register-section">

      <div class="register-card">


        <!-- CABEÇALHO -->

        <div class="register-header">

          <span class="register-icon">
            <i class="bi bi-person-plus"></i>
          </span>

          <h2>
            Criar sua conta
          </h2>

          <p>
            Preencha seus dados para começar
          </p>

        </div>



        <!-- ERRO -->

        <% if (typeof error !=='undefined' && error) { %>

          <div class="error-message">

            <i class="bi bi-exclamation-circle"></i>

            <%= error %>

          </div>

          <% } %>



            <!-- FORM -->

            <form action="/register" method="POST" id="registerForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"> 

              <!-- =====================
                         DADOS PESSOAIS
                    ====================== -->

              <div class="form-title">

                <i class="bi bi-person"></i>

                <span>
                  Dados pessoais
                </span>

              </div>


              <div class="form-grid">


                <!-- NOME -->

                <div class="input-group">

                  <label for="name">
                    Nome
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-person"></i>

                    <input type="text" id="name" name="nome" value="<%= dadosFormulario?.nome || '' %>" placeholder="Digite seu nome" autocomplete="name" required>

                  </div>

                </div>


                <!-- EMAIL -->

                <div class="input-group">

                  <label for="email">
                    E-mail
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-envelope"></i>

                    <input type="email" id="email" name="email" value="<%= dadosFormulario?.email || '' %>" placeholder="seu@email.com" autocomplete="email"
                      required>

                  </div>

                </div>


                <!-- TELEFONE -->

                <div class="input-group">

                  <label for="telefone">
                    Telefone / WhatsApp
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-whatsapp"></i>

                    <input type="text" id="telefone" name="telefone" value="<%= dadosFormulario?.telefone || '' %>" placeholder="(48) 99999-9999" maxlength="15"
                      required>

                  </div>

                </div>


                <!-- CPF/CNPJ -->

                <div class="input-group">

                  <label for="cpfCnpj">
                    CPF / CNPJ
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-card-text"></i>

                    <input type="text" id="cpfCnpj" name="cpfCnpj" value="<%= dadosFormulario?.cpfCnpj || '' %>" placeholder="999.999.999-99" maxlength="18" required>

                  </div>

                </div>

              </div>



              <!-- =====================
                         SENHA
                    ====================== -->

              <div class="form-title password-title relative">

                <i class="bi bi-shield-lock"></i>

                <span>
                  Segurança da conta
                </span>

              </div>


              <div class="form-grid">


                <!-- SENHA -->

                <div class="input-group">

                  <label for="novaSenha">
                    Sua Senha
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-lock"></i>

                    <input type="password" id="novaSenha" name="novaSenha" placeholder="No mínimo 8 caracteres"
                      minlength="8" autocomplete="new-password" required>

                    <button type="button" class="toggle-senha" data-target="novaSenha" aria-label="Mostrar senha">

                      <i class="bi bi-eye"></i>

                    </button>

                  </div>

                </div>


                <!-- CONFIRMAR -->

                <div class="input-group">

                  <label for="confirmarSenha">
                    Confirme sua Senha
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-lock-fill"></i>

                    <input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Repita sua senha"
                      minlength="8" autocomplete="new-password" required>

                    <button type="button" class="toggle-senha" data-target="confirmarSenha" aria-label="Mostrar senha">

                      <i class="bi bi-eye"></i>

                    </button>

                  </div>

                  <p id="mensagemErro" class="password-error hidden">

                    <i class="bi bi-exclamation-circle"></i>

                    As senhas não coincidem.

                  </p>

                </div>

              </div>



              <!-- =====================
                         ENDEREÇO
                    ====================== -->

              <div class="form-title address-title">

                <i class="bi bi-geo-alt"></i>

                <span>
                  Endereço
                </span>

              </div>


              <!-- CEP + NÚMERO -->

              <div class="form-grid address-top">


                <!-- CEP -->

                <div class="input-group">

                  <label for="cep">
                    CEP
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-mailbox"></i>

                    <input type="text" id="cep" name="cep" value="<%= dadosFormulario?.cep || '' %>" placeholder="00000-000" maxlength="9" required>

                  </div>

                </div>


                <!-- NÚMERO -->

                <div class="input-group">

                  <label for="numero">
                    Número
                  </label>

                  <div class="input-wrapper">

                    <i class="bi bi-hash"></i>

                    <input type="text" id="numero" name="numero" value="<%= dadosFormulario?.numero || '' %>" placeholder="123" required>

                  </div>

                </div>

              </div>


              <!-- RUA -->

              <div class="input-group">

                <label for="rua">
                  Rua
                </label>

                <div class="input-wrapper">

                  <input type="text" id="rua" name="rua" value="<%= dadosFormulario?.rua || '' %>" placeholder="Rua Exemplo" required>

                </div>

              </div>


              <!-- BAIRRO + COMPLEMENTO -->

              <div class="form-grid">


                <div class="input-group">

                  <label for="bairro">
                    Bairro
                  </label>

                  <div class="input-wrapper">

                    <input type="text" id="bairro" name="bairro" value="<%= dadosFormulario?.bairro || '' %>" placeholder="Centro" required>

                  </div>

                </div>


                <div class="input-group">

                  <label for="complemento">
                    Complemento
                  </label>

                  <div class="input-wrapper">

                    <input type="text" id="complemento" name="complemento" value="<%= dadosFormulario?.complemento || '' %>" placeholder="Apto, bloco, etc.">

                  </div>

                </div>

              </div>


              <!-- CIDADE + UF -->

              <div class="form-grid city-grid">


                <div class="input-group">

                  <label for="cidade">
                    Cidade
                  </label>

                  <div class="input-wrapper">

                    <input type="text" id="cidade" name="cidade" value="<%= dadosFormulario?.cidade || '' %>" placeholder="São Paulo" required>

                  </div>

                </div>


                <div class="input-group">

                  <label for="uf">
                    UF
                  </label>

                  <div class="input-wrapper">

                    <input type="text" id="uf" name="uf" value="<%= dadosFormulario?.uf || '' %>" placeholder="SP" maxlength="2" required>

                  </div>

                </div>

              </div>



              <!-- =====================
                         BOTÃO
                    ====================== -->

              <button type="submit" class="register-button">

                <span>
                  Criar minha conta
                </span>

                <i class="bi bi-arrow-right"></i>

              </button>


              <!-- LOGIN -->

              <div class="already-account">

                <span>
                  Já possui uma conta?
                </span>

                <a href="/login">
                  Fazer Login
                </a>

              </div>


            </form>

      </div>

    </section>

  </main>



  <!-- =========================
         FOOTER
    ========================== -->

  <footer>

    <div class="footer-content">

      <div>

        <p class="footer-brand">
          Estoffe
        </p>

        <p class="footer-copy">
          © 2026 Estoffe Estofaria Premium.
          Todos os direitos reservados.
        </p>

      </div>


      <div class="social-icons">

        <a href="#">
          <i class="bi bi-instagram"></i>
        </a>

        <a href="#">
          <i class="bi bi-facebook"></i>
        </a>

        <a href="#">
          <i class="bi bi-whatsapp"></i>
        </a>

      </div>

    </div>

  </footer>



  <!-- =========================
         JAVASCRIPT
    ========================== -->

  <script>

    document.addEventListener("DOMContentLoaded", () => {


      /* =========================
         SENHAS
      ========================= */

      const novaSenha =
        document.getElementById("novaSenha");

      const confirmarSenha =
        document.getElementById("confirmarSenha");

      const mensagemErro =
        document.getElementById("mensagemErro");


      function validarSenhas() {

        if (
          novaSenha.value !==
          confirmarSenha.value
        ) {

          confirmarSenha.setCustomValidity(
            "As senhas não coincidem."
          );

          mensagemErro.classList.remove("hidden");

          return false;

        }

        confirmarSenha.setCustomValidity("");

        mensagemErro.classList.add("hidden");

        return true;
      }


      novaSenha.addEventListener(
        "input",
        validarSenhas
      );

      confirmarSenha.addEventListener(
        "input",
        validarSenhas
      );


      /* =========================
         TELEFONE
      ========================= */

      const telefone =
        document.getElementById("telefone");


      telefone.addEventListener("input", (e) => {

        let valor =
          e.target.value
            .replace(/\D/g, "")
            .slice(0, 11);


        if (valor.length > 10) {

          valor = valor.replace(
            /(\d{2})(\d{5})(\d{4})/,
            "($1) $2-$3"
          );

        }

        else if (valor.length > 6) {

          valor = valor.replace(
            /(\d{2})(\d{4})(\d{1,4})/,
            "($1) $2-$3"
          );

        }

        else if (valor.length > 2) {

          valor = valor.replace(
            /(\d{2})(\d{1,4})/,
            "($1) $2"
          );

        }

        e.target.value = valor;

      });


      /* =========================
         CPF / CNPJ
      ========================= */

      const cpfCnpj =
        document.getElementById("cpfCnpj");


      cpfCnpj.addEventListener("input", (e) => {

        let valor =
          e.target.value
            .replace(/\D/g, "")
            .slice(0, 14);


        if (valor.length <= 11) {

          if (valor.length > 9) {

            valor = valor.replace(
              /(\d{3})(\d{3})(\d{3})(\d{1,2})/,
              "$1.$2.$3-$4"
            );

          }

          else if (valor.length > 6) {

            valor = valor.replace(
              /(\d{3})(\d{3})(\d{1,3})/,
              "$1.$2.$3"
            );

          }

          else if (valor.length > 3) {

            valor = valor.replace(
              /(\d{3})(\d{1,3})/,
              "$1.$2"
            );
          }

        }

        else {

          valor = valor.replace(
            /(\d{2})(\d{3})(\d{3})(\d{4})(\d{1,2})/,
            "$1.$2.$3/$4-$5"
          );

        }

        e.target.value = valor;

      });


      /* =========================
         CEP
      ========================= */

      const cep =
        document.getElementById("cep");


      cep.addEventListener("input", (e) => {

        let valor =
          e.target.value
            .replace(/\D/g, "")
            .slice(0, 8);


        if (valor.length > 5) {

          valor = valor.replace(
            /(\d{5})(\d{1,3})/,
            "$1-$2"
          );

        }

        e.target.value = valor;

      });


      /* =========================
         BUSCAR CEP
      ========================= */

      cep.addEventListener("blur", async () => {

        const valorCep =
          cep.value.replace(/\D/g, "");


        if (valorCep.length !== 8) {
          return;
        }


        try {

          const response =
            await fetch(
              `https://viacep.com.br/ws/${valorCep}/json/`
            );


          if (!response.ok) {

            throw new Error(
              "Erro ao consultar CEP"
            );

          }


          const dados =
            await response.json();


          if (dados.erro) {

            alert(
              "CEP não encontrado."
            );

            return;
          }


          document.getElementById("rua").value =
            dados.logradouro || "";

          document.getElementById("bairro").value =
            dados.bairro || "";

          document.getElementById("cidade").value =
            dados.localidade || "";

          document.getElementById("uf").value =
            dados.uf || "";


          document
            .getElementById("numero")
            .focus();


        } catch (error) {

          console.error(
            "Erro ao buscar CEP:",
            error
          );

          alert(
            "Não foi possível buscar o endereço."
          );

        }

      });


      /* =========================
         SUBMIT
      ========================= */

      document
        .getElementById("registerForm")
        .addEventListener("submit", (e) => {

          if (!validarSenhas()) {

            e.preventDefault();

          }

        });

    });

  </script>


  <!-- TOGGLE SENHA -->

  <script src="/pages/js/toggleSenha.js"></script>

  <script src="/pages/animacoes/anima_gerais.js"></script>

</body>

</html>