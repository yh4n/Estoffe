<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notificações - Estoffe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/png" href="/image/Icons/favicon-96x96.png" sizes="96x96">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="min-h-screen bg-stone-50 text-gray-800 antialiased">
  <% if (usuario.tipo === 'admin') { %>
    <%- include('admin/_admin-nav') %>
  <% } else { %>
    <header class="border-b border-white/10 bg-green-950 px-4 py-4 text-white shadow sm:px-6">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
        <a href="/client-dashboard" class="font-bold tracking-wide">ESTOFFE</a>
        <div class="flex items-center gap-4 text-sm">
          <a href="/client-dashboard" class="text-green-100 transition hover:text-amber-200">Meus pedidos</a>
          <a href="/notificacoes" class="flex items-center gap-1 text-green-100 transition hover:text-amber-200" aria-current="page">
            <i class="bi bi-bell" aria-hidden="true"></i><span>Notificações</span>
            <span data-notification-count class="hidden min-w-5 rounded-full bg-amber-400 px-1.5 py-0.5 text-center text-[10px] font-bold leading-none text-green-950"></span>
          </a>
          <form action="/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-green-100 transition hover:text-amber-200">Sair</button>
          </form>
        </div>
      </div>
    </header>
  <% } %>

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-green-800">Central de avisos</p>
        <h1 class="mt-1 text-3xl font-bold text-gray-900">Notificações</h1>
        <p class="mt-1 text-sm text-gray-600">
          <span data-notification-unread><%= notificacoes.filter((notificacao) => !notificacao.lida).length %></span> não lida(s)
        </p>
      </div>
      <div class="flex flex-col items-start gap-1 sm:items-end">
        <button id="browser-notifications-toggle" type="button" class="rounded-md border border-green-800 bg-white px-4 py-2 text-sm font-semibold text-green-900 transition hover:bg-green-50">
          Ativar avisos no navegador
        </button>
        <p id="browser-notifications-status" class="text-xs text-gray-500" role="status" aria-live="polite"></p>
      </div>
      <% if (notificacoes.some((notificacao) => !notificacao.lida)) { %>
        <form action="/notificacoes/lidas" method="POST" data-mark-all-read>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100">
            Marcar todas como lidas
          </button>
        </form>
      <% } %>
    </div>

    <% if (notificacoes.length) { %>
      <div class="space-y-3">
        <% notificacoes.forEach((notificacao) => { %>
          <article class="rounded-xl border p-5 shadow-sm <%= notificacao.lida ? 'border-gray-200 bg-white' : 'border-green-200 bg-green-50' %>">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="flex gap-3">
                <span class="mt-0.5 text-xl <%= notificacao.tipo === 'oferta' ? 'text-amber-700' : 'text-green-800' %>">
                  <i class="bi <%= notificacao.tipo === 'oferta' ? 'bi-tag-fill' : 'bi-bell-fill' %>" aria-hidden="true"></i>
                </span>
                <div>
                  <h2 class="font-bold text-gray-900"><%= notificacao.titulo %></h2>
                  <p class="mt-1 whitespace-pre-line text-sm text-gray-700"><%= notificacao.mensagem %></p>
                  <time class="mt-2 block text-xs text-gray-500" datetime="<%= notificacao.criadaEm.toISOString ? notificacao.criadaEm.toISOString() : notificacao.criadaEm %>">
                    <%= new Date(notificacao.criadaEm).toLocaleString('pt-BR') %>
                  </time>
                </div>
              </div>
              <% if (!notificacao.lida) { %>
                <form action="/notificacoes/<%= notificacao.codNotificacao %>/lida" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="text-xs font-semibold text-green-900 underline hover:text-green-700">
                    Marcar como lida
                  </button>
                </form>
              <% } %>
            </div>
            <% if (notificacao.link) { %>
              <a href="<%= notificacao.link %>" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-green-900 hover:text-green-700">
                Ver detalhes <i class="bi bi-arrow-right" aria-hidden="true"></i>
              </a>
            <% } %>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center">
        <i class="bi bi-bell-slash text-3xl text-gray-400" aria-hidden="true"></i>
        <p class="mt-3 font-semibold text-gray-700">Você está em dia!</p>
        <p class="mt-1 text-sm text-gray-500">Quando houver novidades, ofertas ou atualizações, elas aparecerão aqui.</p>
      </div>
    <% } %>
  </main>
  <% if (usuario.tipo !== 'admin') { %>
    <script src="/pages/notificacoes.js" defer></script>
  <% } %>
</body>

</html>
